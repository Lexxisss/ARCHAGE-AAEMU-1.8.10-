<?xml version="1.0" encoding="utf-8" ?>
<nlog autoReload="true" xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <targets async="true">
      <target name="console" 
              xsi:type="ColoredConsole" 
              layout="${date:format=HH\:mm\:ss} [${level:uppercase=true}] ${logger:shortName=true} - ${message} ${exception:format=tostring}" />
      <target name="file" 
              xsi:type="File" 
              fileName="${basedir}/Logs/Server.log" 
              archiveFileName="${basedir}/Logs/Server.{#}.log"
              archiveNumbering="Date" archiveDateFormat="yyyy-MM-dd" archiveEvery="Day" maxArchiveFiles="9"
              layout="${date:format=HH\:mm\:ss} [${level:uppercase=true}] ${logger:shortName=true} - ${message}" 
              keepFileOpen="false" encoding="utf-8" concurrentWrites="false" deleteOldFileOnStartup="true" />
      <target name="npcDebug"
              xsi:type="File"
              fileName="${basedir}/Logs/NpcDebug/NpcDebug.log"
              archiveFileName="${basedir}/Logs/NpcDebug/NpcDebug.{#}.log"
              archiveNumbering="Date" archiveDateFormat="yyyy-MM-dd" archiveEvery="Day" maxArchiveFiles="30"
              layout="${longdate} [${level:uppercase=true}] ${message} ${exception:format=tostring}"
              keepFileOpen="false" encoding="utf-8" concurrentWrites="true" />
      <target name="moveDebug"
              xsi:type="File"
              fileName="${basedir}/Logs/MoveDebug/MoveDebug.log"
              archiveFileName="${basedir}/Logs/MoveDebug/MoveDebug.{#}.log"
              archiveNumbering="Date" archiveDateFormat="yyyy-MM-dd" archiveEvery="Day" maxArchiveFiles="10"
              layout="${longdate} [${level:uppercase=true}] ${message} ${exception:format=tostring}"
              keepFileOpen="false" encoding="utf-8" concurrentWrites="true" />
      <target name="plotDebug"
              xsi:type="File"
              fileName="${basedir}/Logs/PlotDebug/PlotDebug.log"
              archiveFileName="${basedir}/Logs/PlotDebug/PlotDebug.{#}.log"
              archiveNumbering="Date" archiveDateFormat="yyyy-MM-dd" archiveEvery="Day" maxArchiveFiles="10"
              layout="${longdate} [${level:uppercase=true}] ${logger:shortName=true} - ${message} ${exception:format=tostring}"
              keepFileOpen="false" encoding="utf-8" concurrentWrites="true" />
      <target name="doodadDebug"
              xsi:type="File"
              fileName="${basedir}/Logs/DoodadDebug/DoodadDebug.log"
              archiveFileName="${basedir}/Logs/DoodadDebug/DoodadDebug.{#}.log"
              archiveNumbering="Date" archiveDateFormat="yyyy-MM-dd" archiveEvery="Day" maxArchiveFiles="10"
              layout="${longdate} [${level:uppercase=true}] ${logger:shortName=true} - ${message} ${exception:format=tostring}"
              keepFileOpen="false" encoding="utf-8" concurrentWrites="true" />
      <target name="errors" 
              xsi:type="File" 
              fileName="${basedir}/Logs/Error.log" 
              archiveFileName="${basedir}/Logs/Error.{#}.log"
              archiveNumbering="Date" archiveDateFormat="yyyy-MM-dd" archiveEvery="Day" maxArchiveFiles="9"
              layout="${date:format=HH\:mm\:ss} [${level:uppercase=true}] ${logger:shortName=true} - ${message} ${exception:format=tostring}" 
              keepFileOpen="false" encoding="utf-8" concurrentWrites="false" deleteOldFileOnStartup="true" />
    </targets>

    <rules>
      <logger name="NpcDebug" minlevel="Trace" writeTo="npcDebug" final="true" />
      <!-- Movement bodies, written only while the movelog command has them turned on. The rule is
           final so they never reach the console or Server.log, whatever the switch is set to. -->
      <logger name="MoveDebug" minlevel="Trace" writeTo="moveDebug" final="true" />
      <!-- Plot tree diagnostics are written on every tick of every scripted world plot. Same
           treatment as the doodad phases below: their own file, warnings and errors unaffected. -->
      <logger name="AAEmu.Game.Models.Game.Skills.Plots.Tree.PlotNode"
              minlevel="Trace" maxlevel="Debug" writeTo="plotDebug" final="true" />
      <logger name="AAEmu.Game.Models.Game.Skills.Plots.PlotCondition"
              minlevel="Trace" maxlevel="Debug" writeTo="plotDebug" final="true" />
      <!-- Keep high-volume doodad phase diagnostics out of console/Server.log while preserving
           them in a dedicated file. Warnings and errors still continue to the normal targets. -->
      <logger name="AAEmu.Game.Models.Game.DoodadObj.Templates.DoodadPhaseFuncTemplate"
              minlevel="Trace" maxlevel="Debug" writeTo="doodadDebug" final="true" />
      <logger name="AAEmu.Game.Models.Game.DoodadObj.Templates.DoodadFuncTemplate"
              minlevel="Trace" maxlevel="Debug" writeTo="doodadDebug" final="true" />
      <logger name="Quartz*" minlevel="Trace" maxlevel="Info" final="true" /> 
      <logger name="*" minlevel="Debug" writeTo="console" />
      <logger name="*" minlevel="Error" writeTo="errors" />
      <logger name="*" minlevel="Trace" maxlevel="Warn" writeTo="file" />
    </rules>
</nlog>
